rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && 
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['admin', 'super_admin'];
    }

    function isAppOwner(appId) {
      return isAuthenticated() && 
        firestore.get(/databases/(default)/documents/applications/$(appId)).data.userId == request.auth.uid;
    }

    // Pitch decks and application files: accessible only by app owner or admin (Prevents [CRIT-04] Exfiltration & Overwrite)
    match /applications/{appId}/{fileName} {
      allow read: if isAppOwner(appId) || isAdmin();
      allow write: if (isAppOwner(appId) || isAdmin()) && request.resource.size < 10 * 1024 * 1024;
    }

    // Financial invoices: accessible only by app owner or admin
    match /applications/{appId}/invoices/{fileName} {
      allow read: if isAppOwner(appId) || isAdmin();
      allow write: if (isAppOwner(appId) || isAdmin()) && request.resource.size < 10 * 1024 * 1024;
    }

    // Milestone documents
    match /milestone-documents/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.resource.size < 10 * 1024 * 1024;
    }

    // Event promotional materials: write restricted to admins
    match /event-flyers/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() && request.resource.size < 10 * 1024 * 1024;
    }

    // User avatars / personal files: strictly owned by the authenticated user
    match /users/{userId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == userId && request.resource.size < 5 * 1024 * 1024;
    }
  }
}
