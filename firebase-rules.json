{
  "rules": {
    "users": {
      ".read": "auth != null",
      ".indexOn": ["enrollmentNumber"],
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && (auth.uid == $uid || root.child('users').child(auth.uid).child('role').val() == 'admin' || root.child('users').child(auth.uid).child('role').val() == 'super_admin')"
      }
    },
    "applications": {
      "$appId": {
        ".read": "auth != null && (data.child('userId').val() == auth.uid || root.child('users').child(auth.uid).child('role').val() == 'admin' || root.child('users').child(auth.uid).child('role').val() == 'super_admin' || root.child('users').child(auth.uid).child('role').val() == 'mentor')",
        ".write": "auth != null && (
          !data.exists() || 
          root.child('users').child(auth.uid).child('role').val() == 'admin' || 
          root.child('users').child(auth.uid).child('role').val() == 'super_admin' || 
          (data.child('userId').val() == auth.uid && (
            data.child('status').val() == 'Submitted' || 
            data.child('status').val() == 'Under Review' || 
            data.child('status').val() == 'Revision Needed' || 
            data.child('status').val() == 'Revision Submitted' ||
            data.child('status').val() == 'Phase 2 Selected'
          ))
        )"
      },
      ".indexOn": ["userId", "programmeId", "status"]
    },
    "programmes": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() == 'admin' || root.child('users').child(auth.uid).child('role').val() == 'super_admin')"
    },
    "messages": {
      "$chatId": {
        ".read": "auth != null && $chatId.contains(auth.uid)",
        ".write": "auth != null && $chatId.contains(auth.uid)"
      }
    },
    "meetings": {
      "$meetingId": {
        ".read": "auth != null && (data.child('attendees').val().contains(auth.uid) || root.child('users').child(auth.uid).child('role').val() == 'admin' || root.child('users').child(auth.uid).child('role').val() == 'super_admin')",
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() == 'admin' || root.child('users').child(auth.uid).child('role').val() == 'super_admin')"
      },
      ".indexOn": ["applicationId", "startTime"]
    },
    "evaluations": {
      "$appId": {
        ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() == 'admin' || root.child('users').child(auth.uid).child('role').val() == 'super_admin' || root.child('users').child(auth.uid).child('role').val() == 'mentor')",
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() == 'admin' || root.child('users').child(auth.uid).child('role').val() == 'super_admin' || root.child('users').child(auth.uid).child('role').val() == 'mentor')"
      }
    },
    "notifications": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && (auth.uid == $uid || root.child('users').child(auth.uid).child('role').val() == 'admin' || root.child('users').child(auth.uid).child('role').val() == 'super_admin')"
      }
    },
    "enrollment_slugs": {
      ".read": "auth != null",
      "$enrollmentId": {
        ".write": "auth != null && (!data.exists() || data.val() == auth.uid)",
        ".validate": "newData.isString() && newData.val() == auth.uid"
      }
    }
  }
}
